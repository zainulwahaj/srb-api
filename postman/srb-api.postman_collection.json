        {
          "name": "List ROOM-01 slots with free seats",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/slots?roomCode=ROOM-01&hasSeats=true&page=1&limit=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "slots"
              ],
              "query": [
                {
                  "key": "roomCode",
                  "value": "ROOM-01"
                },
                {
                  "key": "hasSeats",
                  "value": "true"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "5"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('paged result', () => { pm.expect(body.data.length).to.be.at.most(5); pm.expect(body).to.have.property('total'); });",
                  "pm.test('only ROOM-01 with seats', () => body.data.forEach((s) => { pm.expect(s.roomCode).to.eql('ROOM-01'); pm.expect(s.booked).to.be.below(s.seats); }));",
                  "pm.collectionVariables.set('slotId', body.data[0].id);"
                ]
              }
            }
          ]
