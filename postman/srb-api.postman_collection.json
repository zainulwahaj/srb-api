    {
      "name": "6. GraphQL",
      "item": [
        {
          "name": "Dashboard query (student + bookings)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/graphql",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "graphql"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"# One request: the student's details and every booking with its room name,\\n# date and start hour. Send to POST /graphql with { \\\"regNo\\\": \\\"FA23-BAI-058\\\" }.\\nquery StudentDashboard($regNo: String!) {\\n  student(regNo: $regNo) {\\n    regNo\\n    name\\n    email\\n    bookings {\\n      slotId\\n      roomCode\\n      roomName\\n      building\\n      date\\n      startHour\\n      bookedAt\\n    }\\n  }\\n}\\n\",\n  \"variables\": {\n    \"regNo\": \"FA23-BCS-045\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('student with bookings', () => pm.expect(pm.response.json().data.student.bookings).to.be.an('array').that.is.not.empty);"
                ]
              }
            }
          ]
        },
        {
          "name": "bookSlot on a full slot (SLOT_FULL)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/graphql",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "graphql"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"mutation Book($regNo: String!, $slotId: ID!) { bookSlot(regNo: $regNo, slotId: $slotId) { roomName date startHour } }\",\n  \"variables\": {\n    \"regNo\": \"{{regNo}}\",\n    \"slotId\": \"{{fullSlotId}}\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('error code SLOT_FULL', () => pm.expect(pm.response.json().errors[0].extensions.code).to.eql('SLOT_FULL'));"
                ]
              }
            }
          ]
        }
      ]
    }
