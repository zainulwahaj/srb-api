points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="c27"><mxGeometry x="0" y="56" width="260" height="26" as="geometry"/></mxCell><mxCell id="c30" value="date : String (YYYY-MM-DD)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="c27"><mxGeometry x="0" y="82" width="260" height="26" as="geometry"/></mxCell><mxCell id="c31" value="startHour : 8 | 10 | 12 | 14 | 16" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="c27"><mxGeometry x="0" y="108" width="260" height="26" as="geometry"/></mxCell><mxCell id="c32" value="seats : Number (copied from Room)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="c27"><mxGeometry x="0" y="134" width="260" height="26" as="geometry"/></mxCell><mxCell id="c33" value="booked : Number (default 0, ≤ seats)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="c27"><mxGeometry x="0" y="160" width="260" height="26" as="geometry"/></mxCell><mxCell id="c34" value="Booking" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="810" y="90" width="240" height="134" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;PK&lt;/b&gt; _id : ObjectId" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="c34"><mxGeometry x="0" y="30" width="240" height="26" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;FK&lt;/b&gt; slot : ObjectId → Slot" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="c34"><mxGeometry x="0" y="56" width="240" height="26" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;FK&lt;/b&gt; student : ObjectId → Student" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="c34"><mxGeometry x="0" y="82" width="240" height="26" as="geometry"/></mxCell><mxCell id="c38" value="bookedAt : Date" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="c34"><mxGeometry x="0" y="108" width="240" height="26" as="geometry"/></mxCell><mxCell id="c39" value="Student" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1190" y="90" width="240" height="134" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;PK&lt;/b&gt; _id : ObjectId" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="c39"><mxGeometry x="0" y="30" width="240" height="26" as="geometry"/></mxCell><mxCell id="c41" value="&lt;u&gt;regNo&lt;/u&gt; : String (unique, FA23-BCS-045)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="c39"><mxGeometry x="0" y="56" width="240" height="26" as="geometry"/></mxCell><mxCell id="c42" value="name : String" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="c39"><mxGeometry x="0" y="82" width="240" height="26" as="geometry"/></mxCell><mxCell id="c43" value="email : String" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="c39"><mxGeometry x="0" y="108" width="240" height="26" as="geometry"/></mxCell><mxCell id="c44" value="has" style="edgeStyle=entityRelationEdgeStyle;fontSize=11;html=1;endFill=0;startFill=0;labelBackgroundColor=#ffffff;strokeWidth=1.5;startArrow=ERmandOne;endArrow=ERzeroToMany;" edge="1" parent="1" source="c21" target="c27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c45" value="is booked in" style="edgeStyle=entityRelationEdgeStyle;fontSize=11;html=1;endFill=0;startFill=0;labelBackgroundColor=#ffffff;strokeWidth=1.5;startArrow=ERmandOne;endArrow=ERzeroToMany;" edge="1" parent="1" source="c27" target="c34"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c46" value="makes" style="edgeStyle=entityRelationEdgeStyle;fontSize=11;html=1;endFill=0;startFill=0;labelBackgroundColor=#ffffff;strokeWidth=1.5;startArrow=ERmandOne;endArrow=ERzeroToMany;" edge="1" parent="1" source="c39" target="c34"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c47" value="&lt;b&gt;Cardinality&lt;/b&gt;&lt;br&gt;• A Room has 0..* Slots; each Slot belongs to exactly 1 Room.&lt;br&gt;• A Slot has 0..* Bookings (at most &lt;i&gt;seats&lt;/i&gt; of them); each Booking is for exactly 1 Slot.&lt;br&gt;• A Student makes 0..* Bookings; each Booking belongs to exactly 1 Student.&lt;br&gt;• So Student and Slot are many-to-many, and Booking is the link between them." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="600" height="110" as="geometry"/></mxCell><mxCell id="c48" value="&lt;b&gt;Rules kept by the database&lt;/b&gt;&lt;br&gt;• unique index (roomCode, date, startHour) on Slot&lt;br&gt;• unique index (student, slot) on Booking: no double booking&lt;br&gt;• booked only increases with findOneAndUpdate where booked &amp;lt; seats" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="810" y="330" width="460" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="3-sequence-book-a-slot" name="3. Sequence: book a slot"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1260" pageHeight="1060" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c49" value="Sequence diagram: a student books a slot (and the slot-full case)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="800" height="40" as="geometry"/></mxCell><mxCell id="c50" value="" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=50;fontSize=12;participant=umlActor;" vertex="1" parent="1"><mxGeometry x="90" y="60" width="40" height="900" as="geometry"/></mxCell><mxCell id="c51" value=":Express&lt;br&gt;route + controller" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=50;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="225" y="60" width="150" height="900" as="geometry"/></mxCell><mxCell id="c52" value=":bookingService" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=50;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="425" y="60" width="150" height="900" as="geometry"/></mxCell><mxCell id="c53" value=":MongoDB" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=50;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="645" y="60" width="150" height="900" as="geometry"/></mxCell><mxCell id="c54" value=":Socket.IO server" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=50;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="855" y="60" width="150" height="900" as="geometry"/></mxCell><mxCell id="c55" value="Boards in&lt;br&gt;room:ROOM-01" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=50;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1055" y="60" width="150" height="900" as="geometry"/></mxCell><mxCell id="c56" value="&lt;b&gt;Student&lt;/b&gt;&lt;br&gt;(Postman / client)" style="text;html=1;align=center;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="112" width="120" height="32" as="geometry"/></mxCell><mxCell id="c57" value="1: POST /students/:regNo/bookings&lt;br&gt;{ slotId }" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="175" as="sourcePoint"/><mxPoint x="300" y="175" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c58" value="2: bookSlot(regNo, slotId)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="200" as="sourcePoint"/><mxPoint x="500" y="200" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c59" value="3: find student, check slot exists" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="500" y="240" as="sourcePoint"/><mxPoint x="720" y="240" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c60" value="student, slot (missing → 404)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;fontSize=11;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="270" as="sourcePoint"/><mxPoint x="500" y="270" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c61" value="4: Booking.exists(student, slot)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="500" y="310" as="sourcePoint"/><mxPoint x="720" y="310" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c62" value="none (already booked → 409 ALREADY_BOOKED)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;fontSize=11;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="340" as="sourcePoint"/><mxPoint x="500" y="340" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c63" value="5: Slot.findOneAndUpdate(&lt;br&gt;{ _id, $expr: booked &amp;lt; seats }, { $inc: { booked: 1 } })" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="500" y="390" as="sourcePoint"/><mxPoint x="720" y="390" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c64" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;width=50;height=24;fontStyle=1;fillColor=none;" vertex="1" parent="1"><mxGeometry x="50" y="420" width="1170" height="470" as="geometry"/></mxCell><mxCell id="c65" value="[a seat was free: slot returned with booked + 1]" style="text;html=1;align=left;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="110" y="422" width="400" height="24" as="geometry"/></mxCell><mxCell id="c66" value="updated slot" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;fontSize=11;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="470" as="sourcePoint"/><mxPoint x="500" y="470" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c67" value="6: Booking.create({ student, slot })" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="500" y="510"