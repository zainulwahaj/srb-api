<mxfile host="app.diagrams.net" agent="srb-api" version="24.7.17"><diagram id="1-deployment" name="1. Deployment"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="620" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Deployment diagram: srb-api" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="500" height="40" as="geometry"/></mxCell><mxCell id="c3" value="&amp;lt;&amp;lt;device&amp;gt;&amp;gt;&lt;br&gt;Student / admin computer" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=12;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="300" height="420" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Web browser&lt;/b&gt;&lt;br&gt;board.html (live seats)&lt;br&gt;admin.html (announcements)&lt;br&gt;socket.io client" style="shape=component;align=left;spacingLeft=36;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="70" y="240" width="240" height="110" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Postman&lt;/b&gt;&lt;br&gt;REST + GraphQL requests" style="shape=component;align=left;spacingLeft=36;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="70" y="380" width="240" height="60" as="geometry"/></mxCell><mxCell id="c6" value="&amp;lt;&amp;lt;execution environment&amp;gt;&amp;gt;&lt;br&gt;Node.js 20+ server (localhost:3000)" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=12;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="600" y="70" width="360" height="500" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;srb-api (Express 5)&lt;/b&gt;&lt;br&gt;app.js / server.js&lt;br&gt;routes → controllers → services → models&lt;br&gt;middleware: logger, 404, error handler" style="shape=component;align=left;spacingLeft=36;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="630" y="140" width="300" height="90" as="geometry"/></mxCell><mxCell id="c8" value="REST API&amp;nbsp; /api/v1/*" style="shape=component;align=left;spacingLeft=36;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="630" y="250" width="300" height="40" as="geometry"/></mxCell><mxCell id="c9" value="Socket.IO&amp;nbsp; namespaces &quot;/&quot; and &quot;/admin&quot;" style="shape=component;align=left;spacingLeft=36;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="630" y="300" width="300" height="40" as="geometry"/></mxCell><mxCell id="c10" value="GraphQL&amp;nbsp; POST /graphql (Apollo Server)" style="shape=component;align=left;spacingLeft=36;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="630" y="390" width="300" height="40" as="geometry"/></mxCell><mxCell id="c11" value="Static files&amp;nbsp; public/ (board.html, admin.html)" style="shape=component;align=left;spacingLeft=36;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="630" y="440" width="300" height="40" as="geometry"/></mxCell><mxCell id="c12" value=".env&amp;nbsp; (PORT, MONGO_URL, ADMIN_KEY)" style="shape=note;size=12;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="630" y="500" width="300" height="40" as="geometry"/></mxCell><mxCell id="c13" value="&amp;lt;&amp;lt;device&amp;gt;&amp;gt;&lt;br&gt;Database server" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgro